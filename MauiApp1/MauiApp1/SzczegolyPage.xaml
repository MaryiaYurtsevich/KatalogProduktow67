<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.SzczegolyPage"
             Title="SzczegolyPage">
    <VerticalStackLayout Padding="30" Spacing="15">
        <Label Text="Nazwa:" />
        <Entry x:Name="NazwaEntry" />
        <Label Text="Cena:" />
        <Entry x:Name="CenaEntry" />
        <Label Text="Ilość:" />
        <Entry x:Name="IloscEntry" />
        
        <Label Text="Kategoria" />

        <Picker 
            x:Name="KategoriaPicker"
            Title="Wybierz kategorię">
            <Picker.Items>
                <x:String>Podzespół</x:String>
                <x:String>Akcesorium</x:String>
                <x:String>Usługa</x:String>
            </Picker.Items>
        </Picker>
        <Button Text="Powrót" Clicked="Wroc_Clicked" />
        <Button Text="Zapisz" Clicked="Zapisz_Clicked" />
        <Button Text="Usuń" Clicked="Usun_Clicked" />
    </VerticalStackLayout>
</ContentPage>