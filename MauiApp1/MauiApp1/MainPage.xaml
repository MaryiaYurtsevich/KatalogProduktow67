<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.MainPage">

    <ScrollView>
        <VerticalStackLayout Padding="30,20" Spacing="15" Background="LightPink">
            <SearchBar x:Name="nameSearchBar" 
                       WidthRequest="400" 
                       Placeholder="Wpisz nazwę produktu" 
                       TextChanged="nameSearchBar_TextChanged"/>

            <Button
                Text="Szukaj"
                Clicked="OnSearchButtonClicked" 
                BackgroundColor="HotPink"
                WidthRequest="400"/>
            <Label
                Text="Katalog produktów"
                FontFamily="Bold"
                FontSize="24"
                HorizontalOptions="Center"
                TextColor="HotPink"
                />
            <Entry
                x:Name="nazwaEntry"
                Placeholder="Nazwa produktu"
                WidthRequest="500"/>

            <Entry
                x:Name="cenaEntry"
                Placeholder="Cena produktu"
                Keyboard="Numeric" 
                WidthRequest="500"/>

            <Picker
                x:Name="kategoriaPicker"
                Title="Wybierz kategorię"
                WidthRequest="500">
                <Picker.Items>
                    <x:String>Jedzenie</x:String>
                    <x:String>Napoje</x:String>
                </Picker.Items>
            </Picker>

            <Button
                Text="Dodaj produkt"
                Clicked="DodajProdukt_Clicked" 
                BackgroundColor="HotPink"
                WidthRequest="400"/>

            <Button
                Text="Usuń zaznaczony produkt"
                Clicked="UsunProdukt_Clicked" 
                BackgroundColor="HotPink"
                WidthRequest="400"/>

            <Label x:Name="iloscLabel" Text="Ilość produktów: 0" />
            <CollectionView
    x:Name="ProductsCollection"
    ItemsSource="{Binding widoczneProdukty}"
    SelectionMode="Single">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid
                            ColumnDefinitions="2*,*,*,*"
                            Padding="10">

                            <Label
                                Text="{Binding Name}"
                                Grid.Column="0" />

                            <Label
                                Text="{Binding Price, StringFormat='{0:F2} zł'}"
                                Grid.Column="1" />

                            <Label
                                Text="{Binding Quantity}"
                                Grid.Column="2" />

                            <Label
                                Text="{Binding Category}"
                                Grid.Column="3" />

                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
