<Window x:Class="KatalogWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KatalogWPF"
        mc:Ignorable="d"
        Title="KatalogProduktów" Height="600" Width="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                    Text="Katalog produktów" HorizontalAlignment="Center" 
                   FontSize="24" Margin="0,0,0,20"/>
        <ListBox Grid.Row="1" Grid.Column="0"
            x:Name="ProduktyListBox">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Nazwa}" Width="220" FontWeight="Bold" />
                        <TextBlock Text="{Binding Kategoria}" Width="120" />
                        <TextBlock Text="{Binding Cena, StringFormat={}{0:F2}zł}" Width="100" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="1" Margin="20, 0,0,0"
                    DataContext="{Binding SelectedItem, ElementName=ProduktyListBox}">
            <TextBlock Text="{Binding Nazwa}" FontSize="18" FontWeight="Bold"/>
            <TextBox x:Name="NazwaTextBox" Text="{Binding Nazwa}" />
            <TextBlock Text="Cena:" FontSize="18" FontWeight="Bold"/>
            <TextBox x:Name="CenaTextBox" Text="{Binding Cena, StringFormat={}{0:F2}zł}" />
            <TextBlock Text="Kategoria:" FontSize="18" FontWeight="Bold" />
    
            <ComboBox x:Name="KategoriaComboBox">
                <ComboBoxItem Content="Elektronika" />
                <ComboBoxItem Content="Odzież" />
                <ComboBoxItem Content="Jedzenie" />
            </ComboBox>
            
            <CheckBox x:Name="PromocjaCheckBox" Content="Promocja" />
            <TextBlock Text="Data dostawy:" FontSize="18" FontWeight="Bold"/>
            <DatePicker x:Name="DataDostawyDatePicker" />
            <TextBlock Text="Sposób dostawy:" FontSize="18" FontWeight="Bold"/>
            <RadioButton x:Name="DostawaKurierRadioButton" Content="Kurier" GroupName="SposobDostawy"/>
            <RadioButton x:Name="DostawaPocztaRadioButton" Content="Poczta" GroupName="SposobDostawy"/>
            <!-- w zależności od typu produktu -->
            <!-- collapsed nie będzie widoczny dopóki nie włączycie go z kodu -->
            <StackPanel x:Name="KolorStackPanel" Visibility="Collapsed">
                <TextBlock Text="Kolor:" FontSize="18" FontWeight="Bold"/>
                <TextBox x:Name="KolorTextBox" />
            </StackPanel>
            <!-- te wartości są tylko do odczytu -->
            <TextBlock Text="{Binding WartoscMagazynu, StringFormat=Wartość magazynu: {0:F2}zł}" 
                       FontSize="14" Margin="0,5,0,0"/>
            <TextBlock Text="{Binding OpisProduktu}"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" Margin="20,0,0,0">
            <TextBlock Text="Produktów: "/>
            <TextBlock x:Name="LiczbaProduktowTextBlock" FontWeight="Bold"/>
            <TextBlock Text=" | Wartość magazynu: "/>
            <TextBlock x:Name="WartoscProduktowTextBlock" FontWeight="Bold"/>
            <!--<Button Content="Drugie okno" Margin="10" Click="Button_Click" />-->
        </StackPanel>
    </Grid>
</Window>
